# Copy this file to ".env" and fill in your own values. Never commit ".env".
DB_HOST=localhost
DB_PORT=3306
DB_USER=task_user
DB_PASSWORD=change_me
DB_NAME=task_manager

# Optional: overrides the DB_* values above if set
# DATABASE_URL=mysql+pymysql://task_user:change_me@localhost:3306/task_manager

# Comma-separated origins allowed to call the API (only needed if the frontend is hosted separately)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
